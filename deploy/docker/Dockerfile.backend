# Core API / Worker / MCP Gateway 共用镜像：一份 uv workspace 依赖。
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 先复制依赖描述以便复用层缓存，再复制源码完成 workspace 安装。
COPY pyproject.toml uv.lock ./
COPY backend ./backend
COPY schemas ./schemas
COPY evals ./evals
RUN uv sync --all-packages --no-dev --frozen

ENV PATH="/app/.venv/bin:$PATH"

# 迁移由 `make migrate` 或一次性 job 执行，容器启动只跑服务本身。
CMD ["uv", "run", "uvicorn", "accremind_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
