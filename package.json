{
  "name": "accremind-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AccreMind V3.1 - Local-first engineering experience & delta engine for DeepSeek Harness (DSH)",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "pretest": "node scripts/build.ts",
    "test": "node --test tests/*.test.ts",
    "verify": "node scripts/build.ts && node --test tests/*.test.ts",
    "ui": "node packages/dsh-plugin/src/cli.ts ui",
    "bootstrap": "node packages/dsh-plugin/src/cli.ts bootstrap",
    "accremind": "node packages/dsh-plugin/src/cli.ts"
  },
  "devDependencies": {
    "@accremind/core": "workspace:*",
    "@accremind/dsh-plugin": "workspace:*"
  }
}
