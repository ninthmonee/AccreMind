# Synthetic loopback development only. No production credentials.
AKB_MODE=synthetic
HOST=127.0.0.1
PORT=3100
AKB_ENDPOINT=http://127.0.0.1:3100
# Explicit synthetic MCP HTTP bridge only; default calls have no content authority.
AKB_SYNTHETIC_TOOLS=0
# Optional: start ops/compose.dev.yml first. Synthetic disposable credentials only.
DATABASE_URL=postgresql://akb_api:synthetic-only@127.0.0.1:55432/accremind_dev
WORKER_DATABASE_URL=postgresql://akb_worker:synthetic-only@127.0.0.1:55432/accremind_dev
# Optional B03/B05/B06/B07/B08/B09 fixed synthetic identity; run pnpm synthetic:seed first. Never real login.
AKB_SYNTHETIC_CONTRIBUTIONS=0
# Operator-selected API identity only; reviewer is a separate fixed synthetic principal.
AKB_SYNTHETIC_ACTOR=contributor
# Optional operator-owned private evidence directory; default is project .local/evidence.
# AKB_SYNTHETIC_EVIDENCE_DIR=
# Optional shared private Git content directory, default project .local/content.
# AKB_SYNTHETIC_CONTENT_DIR=
# For explicit synthetic:seed / migration operator actions, set in local .env if needed:
# MIGRATION_DATABASE_URL=postgresql://akb_migration:synthetic-only@127.0.0.1:55432/accremind_dev
# Organization-owned fields stay blank; current production mode refuses startup.
OIDC_ISSUER=
OIDC_CLIENT_ID=
MODEL_ENDPOINT=
MODEL_ID=
