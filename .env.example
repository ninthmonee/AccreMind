# AccreMind V3.1 本地 DSH 插件可选模型提炼配置（仅用于 `bootstrap --extract` 与后台异步会话增量提炼）
# 本地检索、雷达唤醒、JIT 工具护栏、符号级 Git 时效巡检均为 0-Token 纯本地运行，无需配置任何 Key。

# 兼容 OpenAI / DeepSeek / 本地 Ollama / vLLM 的接口地址
ACCREMIND_LLM_BASE_URL=https://api.deepseek.com/v1
ACCREMIND_LLM_MODEL=deepseek-chat

# API Key（也可直接使用宿主已有的 DEEPSEEK_API_KEY 或 OPENAI_API_KEY）
ACCREMIND_LLM_API_KEY=
# DEEPSEEK_API_KEY=
