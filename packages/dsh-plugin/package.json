{
  "name": "@accremind/dsh-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness (Cordis) native plugin for AccreMind local engineering experience engine",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "accremind": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./webui": "./dist/webui/ui-bundle.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-conversation"]
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dependencies": {
    "@accremind/core": "workspace:*"
  }
}
