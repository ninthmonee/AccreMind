{
  "name": "@accremind/dsh-plugin",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness adapter for AccreMind: capture the engineering experience that code and docs cannot recover, then hand it back at the moment it matters.",
  "license": "MIT",
  "icon": "icon.svg",
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "accremind": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./webui": "./dist/webui/ui-bundle.js",
    "./icon.svg": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "files": [
    "dist/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "src"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "accremind",
    "knowledge-base",
    "engineering-experience",
    "local-first",
    "sqlite-fts5"
  ],
  "homepage": "https://github.com/ninthmonee/AccreMind",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninthmonee/AccreMind.git",
    "directory": "packages/dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/ninthmonee/AccreMind/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@accremind/core": "workspace:*"
  },
  "scripts": {
    "pack:check": "node scripts/check-publishable.mjs"
  }
}
