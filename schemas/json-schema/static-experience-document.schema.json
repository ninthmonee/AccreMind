{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "description": "经验适用条件，用于召回过滤与相关性判断。",
      "properties": {
        "domains": {
          "description": "适用业务或技术领域。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Domains",
          "type": "array"
        },
        "technologies": {
          "description": "适用技术栈。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Technologies",
          "type": "array"
        },
        "project_ids": {
          "description": "明确适用的项目标识。",
          "items": {
            "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Project Ids",
          "type": "array"
        },
        "phases": {
          "description": "适用的研发阶段。",
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "maxItems": 10,
          "title": "Phases",
          "type": "array"
        },
        "triggers": {
          "description": "触发召回的错误或场景关键词。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Triggers",
          "type": "array"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "CandidateDraft": {
      "additionalProperties": false,
      "description": "待审核的经验正文草稿。",
      "properties": {
        "title": {
          "description": "候选经验标题。",
          "maxLength": 200,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "problem": {
          "description": "要解决的问题。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Problem",
          "type": "string"
        },
        "context": {
          "description": "问题发生的背景与约束。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "solution": {
          "description": "已验证的解决方案。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Solution",
          "type": "string"
        },
        "failed_attempts": {
          "description": "无效尝试及其失败原因。",
          "items": {
            "description": "不可为空的正文文本。",
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Failed Attempts",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/ExperienceValidation",
          "description": "解决方案的验证证据。"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability",
          "description": "该经验的适用条件。"
        }
      },
      "required": [
        "title",
        "problem",
        "context",
        "solution",
        "validation",
        "applicability"
      ],
      "title": "CandidateDraft",
      "type": "object"
    },
    "ExperienceValidation": {
      "additionalProperties": false,
      "description": "经验结论的验证证据。",
      "properties": {
        "method": {
          "description": "验证方式或执行步骤。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "result": {
          "description": "验证结果与判定依据。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Result",
          "type": "string"
        },
        "verified_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "最近验证日期。",
          "title": "Verified On"
        }
      },
      "required": [
        "method",
        "result"
      ],
      "title": "ExperienceValidation",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "design",
        "implement",
        "troubleshoot",
        "review",
        "test",
        "deploy"
      ],
      "title": "Phase",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "经验数据的组织、团队、项目或个人可见范围。",
      "properties": {
        "organization_id": {
          "description": "所属组织标识。",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Organization Id",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "所属团队标识。",
          "title": "Team Id"
        },
        "project_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "所属项目标识。",
          "title": "Project Id"
        },
        "personal_owner_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "个人范围所有者标识；不可与团队或项目范围并用。",
          "title": "Personal Owner Id"
        }
      },
      "required": [
        "organization_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validated YAML front matter; Markdown body is handled separately.",
  "properties": {
    "file_id": {
      "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "File Id",
      "type": "string"
    },
    "experience_id": {
      "anyOf": [
        {
          "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experience Id"
    },
    "base_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "导出时的版本，用于更新冲突检测。",
      "title": "Base Version"
    },
    "owner_id": {
      "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Owner Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "experience": {
      "$ref": "#/$defs/CandidateDraft"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "file_id",
    "owner_id",
    "scope",
    "experience",
    "content_hash"
  ],
  "title": "StaticExperienceDocument",
  "type": "object"
}
