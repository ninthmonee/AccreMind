{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "description": "经验适用条件，用于召回过滤与相关性判断。",
      "properties": {
        "domains": {
          "description": "适用业务或技术领域。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Domains",
          "type": "array"
        },
        "technologies": {
          "description": "适用技术栈。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Technologies",
          "type": "array"
        },
        "project_ids": {
          "description": "明确适用的项目标识。",
          "items": {
            "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Project Ids",
          "type": "array"
        },
        "phases": {
          "description": "适用的研发阶段。",
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "maxItems": 10,
          "title": "Phases",
          "type": "array"
        },
        "triggers": {
          "description": "触发召回的错误或场景关键词。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Triggers",
          "type": "array"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "ExperienceFreshness": {
      "enum": [
        "current",
        "review_due",
        "expired"
      ],
      "title": "ExperienceFreshness",
      "type": "string"
    },
    "ExperienceMaturity": {
      "enum": [
        "draft",
        "verified",
        "proven"
      ],
      "title": "ExperienceMaturity",
      "type": "string"
    },
    "ExperienceSource": {
      "additionalProperties": false,
      "description": "经验来源；任务来源与静态文件来源互斥。",
      "properties": {
        "type": {
          "$ref": "#/$defs/SourceType",
          "description": "来源类型。"
        },
        "task_ref": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "产生经验的任务标识。",
          "title": "Task Ref"
        },
        "file_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "静态经验文件标识。",
          "title": "File Id"
        }
      },
      "required": [
        "type"
      ],
      "title": "ExperienceSource",
      "type": "object"
    },
    "ExperienceValidation": {
      "additionalProperties": false,
      "description": "经验结论的验证证据。",
      "properties": {
        "method": {
          "description": "验证方式或执行步骤。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "result": {
          "description": "验证结果与判定依据。",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Result",
          "type": "string"
        },
        "verified_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "最近验证日期。",
          "title": "Verified On"
        }
      },
      "required": [
        "method",
        "result"
      ],
      "title": "ExperienceValidation",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "design",
        "implement",
        "troubleshoot",
        "review",
        "test",
        "deploy"
      ],
      "title": "Phase",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "mcp_task",
        "static_file"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "不可变的经验版本快照。",
  "properties": {
    "experience_id": {
      "description": "所属经验标识。",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Experience Id",
      "type": "string"
    },
    "version": {
      "description": "从 1 开始递增的版本号。",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "title": {
      "description": "经验标题。",
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "problem": {
      "description": "要解决的问题。",
      "maxLength": 10000,
      "minLength": 1,
      "title": "Problem",
      "type": "string"
    },
    "context": {
      "description": "问题背景与约束。",
      "maxLength": 10000,
      "minLength": 1,
      "title": "Context",
      "type": "string"
    },
    "solution": {
      "description": "已验证的解决方案。",
      "maxLength": 10000,
      "minLength": 1,
      "title": "Solution",
      "type": "string"
    },
    "failed_attempts": {
      "description": "无效尝试及失败原因。",
      "items": {
        "description": "不可为空的正文文本。",
        "maxLength": 10000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Failed Attempts",
      "type": "array"
    },
    "validation": {
      "$ref": "#/$defs/ExperienceValidation",
      "description": "验证证据。"
    },
    "applicability": {
      "$ref": "#/$defs/Applicability",
      "description": "适用条件。"
    },
    "source": {
      "$ref": "#/$defs/ExperienceSource",
      "description": "经验来源。"
    },
    "maturity": {
      "$ref": "#/$defs/ExperienceMaturity",
      "description": "经验成熟度。"
    },
    "freshness": {
      "$ref": "#/$defs/ExperienceFreshness",
      "description": "经验新鲜度。"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "经验有效截止日期。",
      "title": "Valid Until"
    },
    "created_at": {
      "description": "版本创建时间。",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "description": "版本创建者标识。",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Created By",
      "type": "string"
    }
  },
  "required": [
    "experience_id",
    "version",
    "title",
    "problem",
    "context",
    "solution",
    "validation",
    "applicability",
    "source",
    "maturity",
    "freshness",
    "created_at",
    "created_by"
  ],
  "title": "ExperienceVersion",
  "type": "object"
}
