{
  "$defs": {
    "Phase": {
      "enum": [
        "design",
        "implement",
        "troubleshoot",
        "review",
        "test",
        "deploy"
      ],
      "title": "Phase",
      "type": "string"
    },
    "RecallBudget": {
      "additionalProperties": false,
      "description": "单次召回的数量与文本预算。",
      "properties": {
        "max_items": {
          "default": 6,
          "description": "最多返回的经验条数。",
          "maximum": 20,
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        },
        "max_tokens": {
          "default": 2400,
          "description": "经验指导文本的最大估算 Token 数。",
          "maximum": 12000,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        }
      },
      "title": "RecallBudget",
      "type": "object"
    },
    "RecallContext": {
      "additionalProperties": false,
      "description": "辅助检索器理解当前任务的上下文。",
      "properties": {
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/Phase"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "当前研发阶段。"
        },
        "technologies": {
          "description": "当前任务使用的技术栈。",
          "items": {
            "description": "不可为空的短文本。",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Technologies",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "description": "不可为空的正文文本。",
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "当前错误信息。",
          "title": "Error"
        },
        "attempted": {
          "description": "已经尝试过的处理方式。",
          "items": {
            "description": "不可为空的正文文本。",
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Attempted",
          "type": "array"
        }
      },
      "title": "RecallContext",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "经验数据的组织、团队、项目或个人可见范围。",
      "properties": {
        "organization_id": {
          "description": "所属组织标识。",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Organization Id",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "所属团队标识。",
          "title": "Team Id"
        },
        "project_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "所属项目标识。",
          "title": "Project Id"
        },
        "personal_owner_id": {
          "anyOf": [
            {
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "个人范围所有者标识；不可与团队或项目范围并用。",
          "title": "Personal Owner Id"
        }
      },
      "required": [
        "organization_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "按任务语义召回经验的请求。",
  "properties": {
    "task_id": {
      "description": "发起召回的任务标识。",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "query": {
      "description": "召回查询文本。",
      "maxLength": 4000,
      "minLength": 2,
      "title": "Query",
      "type": "string"
    },
    "requested_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "请求查询的范围；必须受调用者范围约束。"
    },
    "context": {
      "$ref": "#/$defs/RecallContext",
      "description": "任务上下文。"
    },
    "budget": {
      "$ref": "#/$defs/RecallBudget",
      "description": "返回结果预算。"
    }
  },
  "required": [
    "task_id",
    "query"
  ],
  "title": "RecallRequest",
  "type": "object"
}
