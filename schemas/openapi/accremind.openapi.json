  "components": {
    "schemas": {
      "ActorRole": {
        "type": "string",
        "enum": [
          "developer",
          "reviewer",
          "admin"
        ],
        "title": "ActorRole"
      },
      "Applicability": {
        "properties": {
          "domains": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "description": "不可为空的短文本。"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Domains",
            "description": "适用业务或技术领域。"
          },
          "technologies": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "description": "不可为空的短文本。"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Technologies",
            "description": "适用技术栈。"
          },
          "project_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "description": "稳定标识符，仅允许字母、数字以及 . _ : -。"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Project Ids",
            "description": "明确适用的项目标识。"
          },
          "phases": {
            "items": {
              "$ref": "#/components/schemas/Phase"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Phases",
            "description": "适用的研发阶段。"
          },
          "triggers": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "description": "不可为空的短文本。"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Triggers",
            "description": "触发召回的错误或场景关键词。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Applicability",
        "description": "经验适用条件，用于召回过滤与相关性判断。"
      },
      "CandidateDraft": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Title",
            "description": "候选经验标题。"
          },
          "problem": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Problem",
            "description": "要解决的问题。"
          },
          "context": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Context",
            "description": "问题发生的背景与约束。"
          },
          "solution": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Solution",
            "description": "已验证的解决方案。"
          },
          "failed_attempts": {
            "items": {
              "type": "string",
              "maxLength": 10000,
              "minLength": 1,
              "description": "不可为空的正文文本。"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Failed Attempts",
            "description": "无效尝试及其失败原因。"
          },
          "validation": {
            "$ref": "#/components/schemas/ExperienceValidation",
            "description": "解决方案的验证证据。"
          },
          "applicability": {
            "$ref": "#/components/schemas/Applicability",
            "description": "该经验的适用条件。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "problem",
          "context",
          "solution",
          "validation",
          "applicability"
        ],
        "title": "CandidateDraft",
        "description": "待审核的经验正文草稿。"
      },
      "CandidateStatus": {
        "type": "string",
        "enum": [
          "submitted",
          "processing",
