{
  "openapi": "3.1.0",
  "info": {
    "title": "AccreMind Core API",
    "description": "面向 Coding Agent 的经验闭环核心 API。当前版本提供候选提交、人工发布、经验查询和基础召回；开发态身份通过 X-* 请求头传入。",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "检查服务存活状态",
        "description": "只检查 FastAPI 进程是否能够响应，不访问数据库。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "服务进程状态。",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "检查服务就绪状态",
        "description": "执行一次 `SELECT 1`，确认 Core API 能连接当前数据库。",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "服务与数据库均可用时返回 ready。",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/candidates": {
      "post": {
        "tags": [
          "candidates"
        ],
        "summary": "提交候选经验",
        "description": "由 Coding Agent 或受信客户端提交经过验证和脱敏确认的候选经验。接口只创建 Candidate，不会直接进入生产召回；同一调用者重复使用相同 idempotency_key 时返回原 Candidate。",
        "operationId": "submit_api_v1_candidates_post",
        "parameters": [
          {
            "name": "X-Organization-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "调用者所属组织 ID。",
              "title": "X-Organization-Id"
            },
            "description": "调用者所属组织 ID。"
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "当前调用者稳定 ID。",
              "title": "X-Actor-Id"
            },
            "description": "当前调用者稳定 ID。"
          },
          {
            "name": "X-Actor-Role",
            "in": "header",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ActorRole",
              "description": "开发态角色：developer、reviewer 或 admin。",
              "default": "developer"
            },
            "description": "开发态角色：developer、reviewer 或 admin。"
          },
          {
            "name": "X-Team-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选的团队权限边界。",
              "title": "X-Team-Id"
            },
            "description": "可选的团队权限边界。"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选的项目权限边界。",
              "title": "X-Project-Id"
            },
            "description": "可选的项目权限边界。"
          },
          {
            "name": "X-Personal-Owner-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选的个人权限边界。",
              "title": "X-Personal-Owner-Id"
            },
            "description": "可选的个人权限边界。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperienceSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新建或幂等命中的候选经验。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
