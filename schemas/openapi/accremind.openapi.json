                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选的团队权限边界。",
              "title": "X-Team-Id"
            },
            "description": "可选的团队权限边界。"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选的项目权限边界。",
              "title": "X-Project-Id"
            },
            "description": "可选的项目权限边界。"
          },
          {
            "name": "X-Personal-Owner-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选的个人权限边界。",
              "title": "X-Personal-Owner-Id"
            },
            "description": "可选的个人权限边界。"
          }
        ],
        "responses": {
          "200": {
            "description": "进入 ready_for_review 状态的 Candidate。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
