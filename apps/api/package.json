{
  "name": "@accremind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@accremind/contracts": "workspace:*",
    "@accremind/domain": "workspace:*",
    "fastify": "5.12.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  },
  "exports": {
    "./publication-worker": {
      "types": "./dist/publication-worker.d.ts",
      "import": "./dist/publication-worker.js"
    },
    "./search-index": {
      "types": "./dist/search-index.d.ts",
      "import": "./dist/search-index.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "import": "./dist/stores.js"
    }
  }
}
